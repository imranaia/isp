# Copy this file to .env and fill in your keys. Never share .env.

# Dojah - from your Dojah dashboard
# Sandbox (testing): https://sandbox.dojah.io   Live: https://api.dojah.io
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

PORT=3001

# Super admin sign-in, used only the first time the server starts (change the password after signing in)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=choose-a-strong-password
