{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__path=$1" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/app.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  }
}
